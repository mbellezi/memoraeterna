{
  "name": "memora-eterna",
  "version": "0.0.0",
  "private": true,
  "description": "Local-first desktop knowledge base for long-term memory.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty false && npm run typecheck:scripts",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --pretty false && tsc -p scripts/spikes/corpus/tsconfig.json --pretty false && tsc -p scripts/spikes/decisions/tsconfig.json --pretty false && tsc -p scripts/spikes/reranker/tsconfig.json --pretty false && tsc -p scripts/spikes/topic-tree/tsconfig.json --pretty false && tsc -p scripts/golden/tsconfig.json --pretty false && tsc -p scripts/relations/tsconfig.json --pretty false && tsc -p scripts/soak/tsconfig.json --pretty false",
    "test": "vitest run",
    "test:graph-webgl": "electron scripts/verify-graph-webgl.mjs",
    "lint": "eslint .",
    "lint:prune": "eslint . --prune-suppressions",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs && prettier --check .",
    "setup:env": "node scripts/setup-dev-env.mjs",
    "setup:dev": "node scripts/setup-dev-env.mjs && node scripts/install-postgres-sidecar.mjs",
    "sidecar:install:postgres": "node scripts/install-postgres-sidecar.mjs",
    "db:generate": "npm run db:generate -w @app/db",
    "db:migrate": "npm run db:migrate -w @app/db",
    "db:verify": "npm run db:verify -w @app/db",
    "db:phase2:verify": "npm run db:phase2:verify -w @app/db",
    "db:phase3:verify": "npm run db:phase3:verify -w @app/db",
    "db:phase4:verify": "npm run db:phase4:verify -w @app/db",
    "db:phase5:verify": "npm run db:phase5:verify -w @app/db",
    "db:source-ingestion:verify": "npm run db:source-ingestion:verify -w @app/db",
    "phase4:e2e": "npm run phase4:e2e -w @app/desktop",
    "mlx:build": "npm run native:mlx:build -w @app/desktop",
    "mlx:smoke": "tsx scripts/smoke-mlx-helper.ts",
    "docling:build": "node scripts/build-docling-sidecar.mjs",
    "docling:verify": "node scripts/build-docling-sidecar.mjs --verify",
    "docling:smoke": "node scripts/build-docling-sidecar.mjs --smoke",
    "docling:remove": "node scripts/build-docling-sidecar.mjs --remove",
    "package:desktop:dir": "npm run package:dir -w @app/desktop",
    "package:desktop:mac": "npm run package:mac -w @app/desktop",
    "package:desktop:smoke": "node scripts/smoke-packaged-desktop.mjs",
    "db:seed:verify": "npm run db:seed:verify -w @app/db",
    "db:relations:verify": "npm run db:relations:verify -w @app/db --",
    "db:seed:sync": "node scripts/sync-db-baseline.mjs",
    "sidecar:spike": "tsx scripts/postgres-sidecar-spike.ts",
    "db:prompts:verify": "node --import tsx scripts/verify-prompts.ts",
    "db:restore": "tsx scripts/db/restore-backup.ts",
    "kpi": "tsx scripts/kpi/kpi.ts",
    "golden:evaluate": "tsx scripts/golden/evaluate-matching.ts",
    "golden:rescore": "tsx scripts/golden/rescore.ts",
    "golden:reverse-only": "tsx scripts/golden/reverse-only.ts",
    "golden:calls": "tsx scripts/golden/calls-per-chapter.ts",
    "golden:recall": "tsx scripts/golden/candidate-recall.ts",
    "golden:cassette-nonreg": "tsx scripts/golden/cassette-nonreg.ts",
    "relations:rematch-report": "tsx scripts/relations/rematch-report.ts",
    "soak:report": "tsx scripts/soak/report.ts",
    "soak:latency-fit": "tsx scripts/soak/latency-fit.ts",
    "topics:replay": "tsx scripts/topics/replay.ts",
    "topics:audit": "tsx scripts/topics/audit.ts",
    "topics:bench": "tsx scripts/topics/read-benchmark.ts",
    "topics:export": "tsx scripts/topics/export.ts",
    "topics:profiles": "tsx scripts/topics/env-profiles.ts",
    "topics:rating": "tsx scripts/topics/rating-page.ts",
    "topics:report": "tsx scripts/topics/report.ts",
    "topics:e2e": "tsx apps/desktop/src/main/services/verify-topics-e2e.ts",
    "ratchet": "node scripts/quality-ratchet.mjs",
    "contrast": "tsx scripts/contrast/check-contrast.ts",
    "check": "npm run typecheck && npm test && npm run format:check && npm run lint && npm run ratchet && npm run contrast",
    "check:changed": "node scripts/check-changed.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.2",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "tsx": "4.23.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "4.1.9"
  },
  "allowScripts": {
    "node-llama-cpp@3.19.0": true
  }
}
