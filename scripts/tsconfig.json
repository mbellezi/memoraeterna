{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "./*.ts",
    "./contrast/**/*.ts",
    "./db/**/*.ts",
    "./fixtures/**/*.ts",
    "./kpi/**/*.ts",
    "./objects/**/*.ts",
    "./spikes/*.ts",
    "./spikes/lib/*.ts",
    "./topics/**/*.ts"
  ]
}
