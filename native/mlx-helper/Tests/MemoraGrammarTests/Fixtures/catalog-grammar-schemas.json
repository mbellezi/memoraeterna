          }
        ],
        "relations": [
          {
            "subjectEntityKey": "e1",
            "predicate": "wrote_about",
            "displayLabel": "wrote about",
            "definition": "The subject wrote about the object.",
            "objectEntityKey": "e2",
            "confidence": 0.75,
            "evidenceChunkIds": [
              "c2"
            ]
          }
        ]
      },
      {
        "entities": [],
        "relations": []
      }
