  "atomic_notes": {
    "schema": {
      "type": "object",
      "properties": {
        "notes": {
          "maxItems": 50,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "bodyMarkdown": {
                "type": "string",
                "minLength": 1
              },
              "ideaStatement": {
                "type": "string",
                "minLength": 1
              },
              "language": {
                "type": "string",
                "enum": [
                  "en",
                  "pt-BR",
                  "it",
                  "fr",
                  "es"
                ]
              },
              "evidenceChunkIds": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$"
                }
              }
            },
            "required": [
              "title",
              "bodyMarkdown",
              "ideaStatement",
              "evidenceChunkIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "notes"
      ],
      "additionalProperties": false
    },
    "valid": [
      {
        "notes": [
          {
            "title": "Memory",
            "bodyMarkdown": "Notes **hold** one idea.\n\n- \"quoted\"",
            "ideaStatement": "A note holds one idea.",
