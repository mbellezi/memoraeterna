  "knowledge_graph": {
    "schema": {
      "type": "object",
      "properties": {
        "entities": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "identityDescription": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "canonicalEntityId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "Person",
                  "Organization",
                  "Place",
                  "Event",
                  "Concept",
                  "Work",
                  "Publication",
                  "Publisher",
                  "Project",
                  "Product",
                  "FieldOfStudy",
                  "Tag",
                  "Collection"
                ]
              },
              "canonicalName": {
                "type": "string",
                "minLength": 1
              },
              "aliases": {
                "maxItems": 20,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidenceChunkIds": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$"
                }
              }
            },
            "required": [
              "key",
              "identityDescription",
              "type",
              "canonicalName",
              "confidence",
              "evidenceChunkIds"
            ],
            "additionalProperties": false
          }
        },
        "relations": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "subjectEntityKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "predicate": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120,
                "pattern": "^[a-z]+(?:_[a-z]+)*$"
              },
              "displayLabel": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "definition": {
                "type": "string",
                "minLength": 1,
                "maxLength": 400
              },
              "relationTypeId": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$"
              },
              "originalPredicate": {
                "type": "string"
              },
              "objectEntityKey": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "evidenceChunkIds": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9:_-]*$"
                }
              }
            },
            "required": [
              "subjectEntityKey",
              "predicate",
              "displayLabel",
              "definition",
              "objectEntityKey",
              "confidence",
              "evidenceChunkIds"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "entities",
        "relations"
      ],
      "additionalProperties": false
    },
    "valid": [
      {
        "entities": [
          {
            "key": "e1",
            "identityDescription": "The mathematician who wrote the first program",
