{
  "name": "@app/db",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./sidecar": {
      "types": "./dist/sidecar/index.d.ts",
      "default": "./dist/sidecar/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --root ../.. packages/db/src",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:verify": "tsx src/scripts/verify.ts",
    "db:phase2:verify": "tsx src/scripts/verify-phase2.ts",
    "db:phase3:verify": "tsx src/scripts/verify-phase3.ts",
    "db:phase4:verify": "tsx src/scripts/verify-phase4.ts",
    "db:phase5:verify": "tsx src/scripts/verify-phase5.ts",
    "db:source-ingestion:verify": "tsx src/scripts/verify-source-ingestion.ts",
    "db:seed:verify": "tsx src/scripts/verify-seed.ts",
    "db:wall-clock:verify": "tsx src/scripts/verify-wall-clock.ts",
    "db:ai-lanes:verify": "tsx src/scripts/verify-ai-task-run-lanes.ts",
    "db:gardener:verify": "tsx src/scripts/verify-gardener-tasks.ts",
    "db:budget:verify": "tsx src/scripts/verify-budget-class.ts",
    "db:relation-decisions:verify": "tsx src/scripts/verify-relation-decisions.ts",
    "db:relations:verify": "tsx src/scripts/verify-relations-v2.ts",
    "db:ask-text:verify": "tsx src/scripts/verify-ask-text.ts",
    "db:notes-active:verify": "tsx src/scripts/verify-notes-active.ts",
    "db:object-locate:verify": "tsx src/scripts/verify-object-locate.ts",
    "db:topic-overview:verify": "tsx src/scripts/verify-topic-overview.ts",
    "db:topic-load:verify": "tsx src/scripts/verify-topic-load.ts",
    "db:view-history:verify": "tsx src/scripts/verify-view-history.ts",
    "db:note-page:verify": "tsx src/scripts/verify-note-page.ts",
    "db:source-relation-explanations:verify": "tsx src/scripts/verify-source-relation-explanations.ts",
    "db:topics:verify": "tsx src/scripts/verify-topic-tree.ts",
    "db:changes:verify": "tsx src/scripts/verify-change-sets.ts",
    "db:legacy-drop:verify": "tsx src/scripts/verify-legacy-drop.ts"
  },
  "dependencies": {
    "@app/domain": "^0.0.0",
    "@types/pg": "8.20.0",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10"
  }
}
