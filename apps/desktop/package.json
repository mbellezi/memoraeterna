{
  "name": "@app/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Memora Eterna desktop application.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "predev": "npm run package:deps",
    "dev": "electron-vite dev",
    "prebuild": "npm run package:deps",
    "build": "electron-vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run --config vitest.config.ts",
    "phase4:e2e": "tsx src/main/services/verify-phase4-e2e.ts",
    "native:mlx:build": "node ../../scripts/build-mlx-helper.mjs",
    "package:deps": "npm run build -w @app/i18n",
    "package:dir": "npm run package:deps && npm run build && node ../../scripts/prepare-desktop-resources.mjs && electron-builder --dir --config electron-builder.yml",
    "package:mac": "npm run package:deps && npm run build && node ../../scripts/prepare-desktop-resources.mjs && electron-builder --mac --config electron-builder.yml"
  },
  "dependencies": {
    "@app/ai": "0.0.0",
    "@app/conversion": "0.0.0",
    "@app/db": "0.0.0",
    "@app/domain": "0.0.0",
    "@app/i18n": "0.0.0",
    "@app/integration-contracts": "0.0.0",
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ws": "8.21.0",
    "youtubei.js": "17.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@swc/core": "1.15.43",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "tailwindcss": "4.3.2",
    "vite": "7.3.6"
  }
}
